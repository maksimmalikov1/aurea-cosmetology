---
// Интро-заставка. С ПЕРВОГО кадра полностью перекрывает hero бронзовым слоем
// (размытое hero-фото + бронзовый тон + имя по центру) — hero в начале не мелькает.
// Затем весь слой одним плавным движением прозрачности растворяется в hero:
// размытый бронзовый кадр уступает место чёткому hero под ним.
---

<div
  class="preloader"
  id="preloader"
  role="presentation"
  style="position:fixed;inset:0;z-index:100;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#8A7058;"
>
  <img class="preloader__bg" src="/img/hero.webp" alt="" aria-hidden="true" fetchpriority="high" />
  <div class="preloader__tint" aria-hidden="true"></div>
  <span class="preloader__name">AUREA</span>
</div>

<style>
  /* Непрозрачна сразу (никакого появления) → hero не виден в начале.
     Наружу — единый плавный фейд всего слоя. */
  .preloader {
    opacity: 1;
    transition: opacity 1.3s cubic-bezier(.4, 0, .2, 1);
    will-change: opacity;
  }
  .preloader.is-done { opacity: 0; }

  /* Фон заставки = само hero-фото, размытое (чтобы слой «срастался» с hero).
     Блюр статичный — не анимируется, поэтому уход плавный и без рывков. */
  .preloader__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.1); /* запас под блюр, чтобы не было прозрачных краёв */
    filter: blur(34px);
  }

  /* Бронзовый тон поверх размытого кадра — тот самый оттенок. */
  .preloader__tint {
    position: absolute;
    inset: 0;
    background: #8A7058;
    opacity: .82;
  }

  .preloader__name {
    position: relative;
    z-index: 1;
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    color: #FAF8F5;
    font-size: clamp(32px, 3.2vw, 54px);
    letter-spacing: .34em;
    text-indent: .34em; /* оптическая компенсация трекинга — по центру */
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var pre = document.getElementById('preloader');
    if (!pre) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    try { document.body.style.overflow = 'hidden'; } catch (e) {}

    function cleanup(e) {
      if (e) {
        if (e.target !== pre) return;          // только собственный переход контейнера
        if (e.propertyName !== 'opacity') return;
      }
      try { document.body.style.overflow = ''; } catch (err) {}
      if (pre && pre.parentNode) pre.parentNode.removeChild(pre);
    }

    if (reduce) {
      setTimeout(function () {
        try { document.body.style.overflow = ''; } catch (err) {}
        if (pre.parentNode) pre.parentNode.removeChild(pre);
      }, 450);
      return;
    }

    pre.addEventListener('transitionend', cleanup);

    var HOLD = 1000; // держим заставку, затем один плавный фейд в hero
    setTimeout(function () { pre.classList.add('is-done'); }, HOLD);
    setTimeout(cleanup, HOLD + 1800); // страховка, если transitionend не придёт
  })();
</script>
