---
import Base from '../../layouts/Base.astro';
import PillCta from '../../components/PillCta.astro';
import {
  CATEGORIES, CATEGORY_META, CATEGORY_DETAILS,
  SERVICES, formatAmount, formatDuration,
} from '../../data/services';
import type { ServiceCategoryId } from '../../data/services';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { cat: c.id } }));
}

const { cat } = Astro.params;
const category = CATEGORIES.find((c) => c.id === cat);
if (!category) throw new Error(`Category not found: ${cat}`);

const meta = CATEGORY_META[cat as ServiceCategoryId];
const detail = CATEGORY_DETAILS[cat as ServiceCategoryId];
const list = SERVICES.filter((s) => s.category === cat);

// «4 этапа», «5 этапов» …
function plural(n: number, one: string, few: string, many: string) {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
  return many;
}
const stepsWord = plural(detail.steps.length, 'этап', 'этапа', 'этапов');
---

<Base title={`${category.title} · AUREA`} description={meta.desc} variant="light">
  <article class="shell pt-6 pb-16 lg:pt-12 lg:pb-24">
    <a href="/#services" class="inline-flex items-center gap-2 py-2 lg:py-0 text-[12px] lg:text-[13px] uppercase tracking-wider2 text-ink/70 hover:text-ink transition-colors mb-4 lg:mb-10">
      ← Все направления
    </a>

    <!-- Hero: фото слева, текст справа -->
    <section class="grid grid-cols-1 gap-8 md:gap-10 lg:grid-cols-2 lg:gap-16 items-center" aria-labelledby="cat-title">
      <div class="media aspect-square md:aspect-[16/10] lg:aspect-square rounded-[10px] bg-sand" data-reveal="image">
        <img src={detail.heroImg.src} alt={detail.heroImg.alt}
             style={`object-position: ${detail.heroImg.pos ?? '50% 50%'}`}
             width="640" height="640" fetchpriority="high" data-parallax="0.07" />
      </div>

      <div class="max-w-[620px] lg:max-w-[520px]" data-stagger="90">
        <h1 id="cat-title" class="font-display text-ink text-[34px] md:text-[44px] lg:text-[length:clamp(40px,3.6vw,54px)]" data-split style="line-height: 1.08;">
          {category.title}
        </h1>
        <p class="mt-4 lg:mt-5 text-ink/80 text-[16px] lg:text-[17px] leading-[1.6]">
          {meta.desc}
        </p>
        <h2 class="mt-7 lg:mt-8 font-display italic text-bronze text-[21px] lg:text-[22px] leading-tight">
          {detail.aboutTitle}
        </h2>
        <p class="mt-3 text-ink/75 text-[15px] lg:text-[16px] leading-[1.7]">
          {detail.about}
        </p>
        <div class="mt-8 lg:mt-10">
          <PillCta href="/booking" />
        </div>
      </div>
    </section>

    <!-- Этапы визита -->
    <section class="mt-16 lg:mt-24" aria-labelledby="steps-title">
      <h2 id="steps-title" class="font-display text-[30px] md:text-[36px] lg:text-[clamp(32px,3vw,42px)] leading-tight" data-split>
        Визит в {detail.steps.length} {stepsWord}:
      </h2>

      <ol class="mt-6 lg:mt-8 grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-4" data-stagger="100">
        {detail.steps.map((step, i) => (
          <li class="h-full">
            <div class="step-card">
              <div class="text-[11px] uppercase tracking-wider2 font-bold text-ink">Этап {i + 1}</div>
              <h3 class="mt-2 font-display italic text-bronze text-[21px] leading-tight">{step.title}</h3>
              <div class="step-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              <p class="text-ink/75 text-[14.5px] leading-[1.6]">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Советы косметолога: широкая строка из колонок, значок «сидит» на линии -->
    <section class="mt-16 lg:mt-28" aria-labelledby="tips-title">
      <div class="flex flex-col items-start gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
        <h2 id="tips-title" class="font-display leading-[1.02] text-[36px] md:text-[48px] lg:text-[length:clamp(44px,4vw,60px)]" data-split>
          Советы <em class="text-bronze">косметолога</em>
        </h2>
        <p class="max-w-[340px] lg:pb-2 text-ink/70 text-[15px] leading-[1.6]" data-reveal style="--reveal-delay:120ms">
          Простые правила, которые помогут сохранить результат процедур дольше.
        </p>
      </div>

      <ul class={`mt-12 lg:mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-12 lg:gap-y-14 ${detail.tips.length % 4 === 0 ? 'lg:grid-cols-4' : 'lg:grid-cols-5'}`} data-stagger="90">
        {detail.tips.map((tip) => (
          <li class="tip">
            <span class="tip__mark" aria-hidden="true">
              <svg viewBox="0 0 32 32">
                <circle cx="16" cy="16" r="16" fill="#8C715B" />
                <circle cx="16" cy="16" r="6.5" fill="none" stroke="#FAF8F5" stroke-width="1.5" />
                <circle cx="16" cy="16" r="2" fill="#FAF8F5" />
              </svg>
            </span>
            <p class="text-ink/80 text-[15px] lg:text-[16px] leading-[1.6]">{tip}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Процедуры и цены: меню, заголовок слева закреплён -->
    <section class="mt-16 lg:mt-28 lg:grid lg:grid-cols-12 lg:gap-x-16" aria-labelledby="prices-title">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-10">
          <span class="eyebrow" data-reveal="fade">Прайс</span>
          <h2 id="prices-title" class="mt-4 font-display leading-[1.02] text-[36px] md:text-[48px] lg:text-[length:clamp(44px,4vw,60px)]" data-split>
            Процедуры <em class="text-bronze">и&nbsp;цены</em>
          </h2>
          <p class="mt-4 lg:mt-6 max-w-[340px] lg:max-w-[300px] text-ink/70 text-[15px] leading-[1.65]" data-reveal style="--reveal-delay:250ms">
            Выберите процедуру&nbsp;— откроется онлайн-запись, где она уже будет отмечена.
          </p>
          <div class="mt-9 hidden lg:block" data-reveal style="--reveal-delay:400ms"><PillCta href="/booking" /></div>
        </div>
      </div>

      <ol class="mt-8 lg:mt-0 lg:col-span-8 border-t border-ink/15" data-stagger="70">
        {list.map((s, i) => (
          <li class="draw-line">
            <a href={`/booking?service=${s.slug}`} class="menu-row">
              <span class="menu-row__top">
                <span class="menu-row__num" aria-hidden="true">
                  <span class="menu-row__digits">{String(i + 1).padStart(2, '0')}</span>
                  <svg class="menu-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
                <span class="menu-row__name">{s.title}</span>
                <span class="menu-row__dots" aria-hidden="true"></span>
                <span class="menu-row__price">
                  {s.priceFrom && <span class="menu-row__from">от</span>}
                  {formatAmount(s.price)}<span class="menu-row__cur">₽</span>
                </span>
              </span>
              <span class="menu-row__bottom">
                <span class="menu-row__desc">{s.short}</span>
                <span class="menu-row__time">{formatDuration(s.duration)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>

      <!-- на телефоне и планшете кнопка записи — под прайсом -->
      <div class="mt-10 lg:hidden" data-reveal><PillCta href="/booking" /></div>
    </section>
  </article>
</Base>
